{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://docs.wrangles.com/registry/schema/connector-entry.schema.json",
  "title": "Registry connector contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "type", "catalog_id", "catalog_key", "catalog_kind", "runtime_key", "status", "title", "description", "slug", "visibility", "sources", "source", "operations"],
  "properties": {
    "schema_version": {"const": "0.2"},
    "type": {"const": "connector"},
    "description": {"type": "string", "minLength": 1},
    "slug": {"type": "string", "pattern": "^connectors/[a-z][a-z0-9_.]*$"},
    "visibility": {"const": "public"},
    "sources": {"type": "array", "minItems": 1, "items": {
      "type": "object", "additionalProperties": false, "required": ["id", "resource", "title"],
      "properties": {"id": {"type": "string"}, "resource": {"type": "string"}, "title": {"type": "string"}}
    }},
    "catalog_id": {"type": "string", "pattern": "^[1-9][0-9]*$"},
    "catalog_key": {"type": "string", "pattern": "^connector\\.[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$"},
    "catalog_kind": {"const": "connector"},
    "runtime_key": {"type": "string", "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$"},
    "status": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "guidance": {"type": "string"},
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["repository", "revision", "version", "extraction"],
      "properties": {
        "repository": {"const": "https://github.com/wrangleworks/WranglesPY"},
        "revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "version": {"type": "string", "minLength": 1},
        "extraction": {"const": "static-python-ast"}
      }
    },
    "operations": {
      "type": "object", "minProperties": 1, "additionalProperties": false,
      "properties": {"read": {"type": "object"}, "write": {"type": "object"}, "run": {"type": "object"}}
    }
  }
}
