{
  "name": "wrangles-docs",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "docusaurus": "docusaurus",
    "start": "node ./scripts/start-dev.cjs",
    "start:docusaurus": "NODE_OPTIONS=\"--require ./scripts/os-network-interfaces-polyfill.cjs\" docusaurus start --host 127.0.0.1",
    "start:runner": "node ./scripts/recipe-runner-server.cjs",
    "build": "docusaurus build",
    "swizzle": "docusaurus swizzle",
    "deploy": "docusaurus deploy",
    "clear": "docusaurus clear",
    "compile:registry": "node ./scripts/compile-registry.cjs",
    "import:catalog-snapshot": "node ./scripts/import-catalog-snapshot.cjs",
    "test:registry": "python3 ../scripts/test_refresh_registry.py && node --test ./scripts/compile-registry.test.cjs ./scripts/connector-registry.test.cjs ./scripts/schema-alignment.test.cjs ./scripts/generate-playground-registry.test.cjs ./scripts/repository-layout.test.cjs ./scripts/catalog-schema-audit.test.cjs",
    "check:registry": "node ./scripts/import-runtime-snapshot.cjs --check && npm run test:registry && node ./scripts/compile-registry.cjs --check && npm run generate:playground-registry -- --check",
    "import:runtime-snapshot": "node ./scripts/import-runtime-snapshot.cjs",
    "prebuild": "npm run compile:registry && npm run generate:playground-registry",
    "generate:playground-registry": "node ./scripts/generate-playground-registry.cjs",
    "serve": "docusaurus serve",
    "write-translations": "docusaurus write-translations",
    "write-heading-ids": "docusaurus write-heading-ids",
    "typecheck": "tsc"
  },
  "dependencies": {
    "@docusaurus/core": "^3.0.0",
    "@docusaurus/preset-classic": "^3.0.0",
    "@docusaurus/theme-mermaid": "^3.0.0",
    "@mdx-js/react": "^3.0.0",
    "ajv": "8.17.1",
    "clsx": "^2.0.0",
    "http-proxy": "^1.18.1",
    "js-yaml": "^4.1.1",
    "prism-react-renderer": "^2.1.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "^3.0.0",
    "@docusaurus/tsconfig": "^3.0.0",
    "@docusaurus/types": "^3.0.0",
    "typescript": "~5.2.2"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "engines": {
    "node": ">=18.0"
  }
}
